// Navbar shadow on scroll
window.addEventListener("scroll", () => {
    const nav = document.querySelector(".navbar");
    if (window.scrollY > 50) {
        nav.style.boxShadow = "0 10px 30px rgba(29,108,255,0.25)";
    } else {
        nav.style.boxShadow = "none";
    }
});
